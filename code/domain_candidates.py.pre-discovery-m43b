#!/usr/bin/env python3
"""
Corporation Helix - M4.3B domain candidate/evidence layer.

Purpose
-------
Convert corporate entity seeds plus independent domain/infrastructure
observations into auditable DomainCandidate records.

Important architectural rule:
    corporate relationship confidence != infrastructure attribution confidence

This module deliberately does NOT infer a domain from a corporate relationship.
Evidence providers should produce DomainEvidence records.  The policy layer in
this module combines those records into AUTO / REVIEW / REJECT dispositions.

No external dependencies are required.
"""

from __future__ import annotations

import argparse
import json
import re
from dataclasses import asdict, dataclass, field
from enum import Enum
from pathlib import Path
from typing import Any, Iterable, Optional
from urllib.parse import urlsplit


class Disposition(str, Enum):
    AUTO = "AUTO"
    REVIEW = "REVIEW"
    REJECT = "REJECT"


class InfrastructureConfidence(str, Enum):
    HIGH = "HIGH"
    MEDIUM = "MEDIUM"
    LOW = "LOW"
    UNKNOWN = "UNKNOWN"


# Provider adapters should map their observations to a small semantic vocabulary.
class EvidenceType(str, Enum):
    OFFICIAL_WEBSITE = "OFFICIAL_WEBSITE"
    RDAP_REGISTRANT = "RDAP_REGISTRANT"
    RDAP_ORG = "RDAP_ORG"
    RDAP_ATTRIBUTION_MATCH = "RDAP_ATTRIBUTION_MATCH"
    WHOIS_REGISTRANT = "WHOIS_REGISTRANT"
    CERTIFICATE_ORG = "CERTIFICATE_ORG"
    CERTIFICATE_DOMAIN = "CERTIFICATE_DOMAIN"
    EDGAR_REFERENCE = "EDGAR_REFERENCE"
    DNS_OBSERVATION = "DNS_OBSERVATION"
    CUSTOMER_SUPPLIED = "CUSTOMER_SUPPLIED"
    MANUAL_ANALYST = "MANUAL_ANALYST"
    CONTRADICTORY_OWNERSHIP = "CONTRADICTORY_OWNERSHIP"
    RDAP_ATTRIBUTION_CONFLICT = "RDAP_ATTRIBUTION_CONFLICT"
    OTHER = "OTHER"


# Positive evidence weights are intentionally simple for v1.
# AUTO is NOT awarded by score alone; identity-grade evidence is required.
IDENTITY_GRADE = {
    EvidenceType.OFFICIAL_WEBSITE,
    EvidenceType.RDAP_ATTRIBUTION_MATCH,
    EvidenceType.WHOIS_REGISTRANT,
    EvidenceType.CUSTOMER_SUPPLIED,
    EvidenceType.MANUAL_ANALYST,
}

CORROBORATING = {
    EvidenceType.RDAP_REGISTRANT,
    EvidenceType.RDAP_ORG,
    EvidenceType.CERTIFICATE_ORG,
    EvidenceType.CERTIFICATE_DOMAIN,
    EvidenceType.EDGAR_REFERENCE,
    EvidenceType.DNS_OBSERVATION,
}

NEGATIVE = {
    EvidenceType.CONTRADICTORY_OWNERSHIP,
    EvidenceType.RDAP_ATTRIBUTION_CONFLICT,
}


@dataclass(frozen=True)
class CorporateEntity:
    entity_name: str
    entity_lei: Optional[str] = None
    relationships: list[str] = field(default_factory=list)
    corporate_confidence: str = "UNKNOWN"
    jurisdiction: Optional[str] = None
    source: Optional[str] = None

    @staticmethod
    def from_mapping(data: dict[str, Any]) -> "CorporateEntity":
        # Keep this tolerant so a thin adapter can consume likely Helix variants.
        name = (
            data.get("entity_name")
            or data.get("name")
            or data.get("legal_name")
            or data.get("canonical_name")
        )
        if not name:
            raise ValueError(f"Entity is missing a name: {data!r}")

        rels = data.get("relationships")
        if rels is None:
            rel = data.get("relationship")
            rels = [rel] if rel else []
        elif isinstance(rels, str):
            rels = [rels]

        return CorporateEntity(
            entity_name=str(name),
            entity_lei=_none_or_str(data.get("entity_lei") or data.get("lei")),
            relationships=[str(x) for x in rels if x],
            corporate_confidence=str(
                data.get("corporate_confidence")
                or data.get("confidence")
                or "UNKNOWN"
            ).upper(),
            jurisdiction=_none_or_str(
                data.get("jurisdiction") or data.get("legal_jurisdiction")
            ),
            source=_none_or_str(data.get("source") or data.get("provider")),
        )


@dataclass(frozen=True)
class DomainEvidence:
    provider: str
    evidence_type: EvidenceType
    reference: Optional[str] = None
    observed_value: Optional[str] = None
    subject_name: Optional[str] = None
    subject_identifier: Optional[str] = None
    supports_attribution: Optional[bool] = True
    raw: dict[str, Any] = field(default_factory=dict)

    @staticmethod
    def from_mapping(data: dict[str, Any]) -> "DomainEvidence":
        try:
            et = EvidenceType(str(data.get("evidence_type", "OTHER")).upper())
        except ValueError:
            et = EvidenceType.OTHER

        return DomainEvidence(
            provider=str(data.get("provider") or data.get("source") or "UNKNOWN"),
            evidence_type=et,
            reference=_none_or_str(data.get("reference") or data.get("evidence_reference")),
            observed_value=_none_or_str(data.get("observed_value") or data.get("value")),
            subject_name=_none_or_str(data.get("subject_name")),
            subject_identifier=_none_or_str(data.get("subject_identifier")),
            supports_attribution=data.get("supports_attribution", True),
            raw=data.get("raw") or {},
        )


@dataclass
class DomainCandidate:
    entity_name: str
    entity_lei: Optional[str]
    relationships: list[str]
    candidate_domain: str
    registrable_domain: str
    corporate_confidence: str
    infrastructure_attribution_confidence: InfrastructureConfidence
    evidence: list[DomainEvidence]
    disposition: Disposition
    review_reason: Optional[str]
    jurisdiction: Optional[str] = None

    def to_dict(self) -> dict[str, Any]:
        data = asdict(self)
        data["disposition"] = self.disposition.value
        data["infrastructure_attribution_confidence"] = (
            self.infrastructure_attribution_confidence.value
        )
        for item in data["evidence"]:
            item["evidence_type"] = item["evidence_type"].value
        return data


def _none_or_str(value: Any) -> Optional[str]:
    return None if value is None else str(value)


def normalize_domain(value: str) -> str:
    """
    Normalize a host/URL into a lower-case ASCII DNS name.
    This is intentionally syntax normalization, not ownership inference.
    """
    value = value.strip()
    if not value:
        raise ValueError("Domain cannot be empty")

    if "://" in value:
        host = urlsplit(value).hostname
    else:
        # urlsplit needs // to recognize a host without a scheme.
        host = urlsplit("//" + value).hostname

    if not host:
        raise ValueError(f"Could not parse domain/URL: {value!r}")

    host = host.rstrip(".").lower()
    try:
        host = host.encode("idna").decode("ascii")
    except UnicodeError as exc:
        raise ValueError(f"Invalid IDN hostname: {value!r}") from exc

    if len(host) > 253:
        raise ValueError(f"Hostname too long: {host!r}")

    label_re = re.compile(r"^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$")
    labels = host.split(".")
    if len(labels) < 2 or any(not label_re.match(label) for label in labels):
        raise ValueError(f"Invalid hostname: {host!r}")

    return host


def registrable_domain(host: str) -> str:
    """
    Conservative v1 fallback.

    We do NOT ship a hand-written public-suffix list here. Without a PSL-aware
    dependency this returns the last two labels, which is sufficient for common
    .com/.net/.org tests but NOT authoritative for suffixes such as co.uk.

    Production Subfinder export should use a PSL-aware implementation.
    """
    host = normalize_domain(host)
    labels = host.split(".")
    return ".".join(labels[-2:])


def _unique_evidence(items: Iterable[DomainEvidence]) -> list[DomainEvidence]:
    seen = set()
    result = []
    for e in items:
        key = (
            e.provider,
            e.evidence_type.value,
            e.reference,
            e.observed_value,
            e.subject_name,
            e.subject_identifier,
            e.supports_attribution,
        )
        if key not in seen:
            seen.add(key)
            result.append(e)
    return result


def evaluate_evidence(
    evidence: Iterable[DomainEvidence],
) -> tuple[InfrastructureConfidence, Disposition, Optional[str]]:
    """
    Deterministic M4.3B-v1 policy.

    Rules:
    - Explicit contradictory ownership => REJECT.
    - At least one positive identity-grade assertion => AUTO/HIGH.
    - Raw RDAP registrant/org observations are corroborating only; they must be
      interpreted into RDAP_ATTRIBUTION_MATCH before they can support AUTO.
    - Two or more distinct positive corroborating evidence types => REVIEW/MEDIUM.
    - One positive corroborating signal => REVIEW/LOW.
    - No usable evidence => REVIEW/UNKNOWN.

    Deliberately conservative:
    - Corporate confidence is not consulted here.
    - A numeric score alone never upgrades a candidate to AUTO.
    """
    evidence = _unique_evidence(evidence)

    negative = [
        e for e in evidence
        if e.evidence_type in NEGATIVE or e.supports_attribution is False
    ]
    if negative:
        return (
            InfrastructureConfidence.HIGH,
            Disposition.REJECT,
            "Independent infrastructure evidence contradicts attribution.",
        )

    positive_identity = [
        e for e in evidence
        if e.evidence_type in IDENTITY_GRADE and e.supports_attribution is True
    ]
    if positive_identity:
        return (
            InfrastructureConfidence.HIGH,
            Disposition.AUTO,
            "Identity-grade infrastructure/domain evidence supports attribution.",
        )

    corroborating_types = {
        e.evidence_type
        for e in evidence
        if e.evidence_type in CORROBORATING and e.supports_attribution is True
    }
    if len(corroborating_types) >= 2:
        return (
            InfrastructureConfidence.MEDIUM,
            Disposition.REVIEW,
            "Multiple corroborating signals exist, but no identity-grade evidence.",
        )

    if len(corroborating_types) == 1:
        return (
            InfrastructureConfidence.LOW,
            Disposition.REVIEW,
            "Only one corroborating infrastructure signal exists.",
        )

    return (
        InfrastructureConfidence.UNKNOWN,
        Disposition.REVIEW,
        "No independent infrastructure attribution evidence is available.",
    )


def build_candidate(
    entity: CorporateEntity,
    domain: str,
    evidence: Iterable[DomainEvidence],
) -> DomainCandidate:
    host = normalize_domain(domain)
    evidence_list = _unique_evidence(evidence)
    infra_conf, disposition, reason = evaluate_evidence(evidence_list)

    return DomainCandidate(
        entity_name=entity.entity_name,
        entity_lei=entity.entity_lei,
        relationships=list(entity.relationships),
        candidate_domain=host,
        registrable_domain=registrable_domain(host),
        corporate_confidence=entity.corporate_confidence,
        infrastructure_attribution_confidence=infra_conf,
        evidence=evidence_list,
        disposition=disposition,
        review_reason=reason,
        jurisdiction=entity.jurisdiction,
    )


def _extract_entity_records(payload: Any) -> list[dict[str, Any]]:
    """
    Tolerant loader for likely Helix JSON shapes.

    Supported:
      [ {...}, {...} ]
      {"entities": [...]}
      {"related_entities": [...]}
      {"related_legal_entities": [...]}
      {"results": [...]}

    This is deliberately a compatibility adapter, not the canonical contract.
    """
    if isinstance(payload, list):
        return [x for x in payload if isinstance(x, dict)]

    if not isinstance(payload, dict):
        raise ValueError("Entity input must be a JSON object or array.")

    for key in ("entities", "related_entities", "related_legal_entities", "results"):
        value = payload.get(key)
        if isinstance(value, list):
            return [x for x in value if isinstance(x, dict)]

    # A single entity mapping is also allowed.
    if any(k in payload for k in ("entity_name", "name", "legal_name", "lei", "entity_lei")):
        return [payload]

    raise ValueError(
        "Could not find entity records. Expected a list or one of: "
        "entities, related_entities, related_legal_entities, results."
    )


def load_entities(path: Path) -> list[CorporateEntity]:
    payload = json.loads(path.read_text(encoding="utf-8"))
    return [CorporateEntity.from_mapping(x) for x in _extract_entity_records(payload)]


def load_observations(path: Path) -> list[dict[str, Any]]:
    payload = json.loads(path.read_text(encoding="utf-8"))
    if isinstance(payload, dict):
        payload = payload.get("observations", [])
    if not isinstance(payload, list):
        raise ValueError("Observation input must be a JSON list or {'observations': [...]}.")
    return [x for x in payload if isinstance(x, dict)]


def match_entity(
    entities: list[CorporateEntity],
    observation: dict[str, Any],
) -> CorporateEntity:
    lei = observation.get("entity_lei") or observation.get("lei")
    name = observation.get("entity_name") or observation.get("name")

    if lei:
        matches = [e for e in entities if e.entity_lei == str(lei)]
        if len(matches) == 1:
            return matches[0]
        if not matches:
            raise ValueError(f"Observation references unknown LEI {lei!r}")
        raise ValueError(f"Observation LEI {lei!r} is ambiguous")

    if name:
        norm = str(name).casefold().strip()
        matches = [e for e in entities if e.entity_name.casefold().strip() == norm]
        if len(matches) == 1:
            return matches[0]
        if not matches:
            raise ValueError(f"Observation references unknown entity name {name!r}")
        raise ValueError(
            f"Observation entity name {name!r} is ambiguous; provide entity_lei."
        )

    raise ValueError("Observation must include entity_lei or entity_name.")


def candidates_from_observations(
    entities: list[CorporateEntity],
    observations: list[dict[str, Any]],
) -> list[DomainCandidate]:
    """
    Group provider observations by (entity, candidate domain), then evaluate.

    Observation shape:
    {
      "entity_lei": "...",
      "domain": "example.com",
      "provider": "rdap",
      "evidence_type": "RDAP_REGISTRANT",
      "reference": "...",
      "observed_value": "...",
      "supports_attribution": true
    }
    """
    grouped: dict[tuple[str, str], tuple[CorporateEntity, list[DomainEvidence]]] = {}

    for obs in observations:
        entity = match_entity(entities, obs)
        domain = obs.get("domain") or obs.get("candidate_domain")
        if not domain:
            raise ValueError(f"Observation missing domain: {obs!r}")
        host = normalize_domain(str(domain))

        # Prefer LEI as stable key; fall back to exact entity name for unresolved IDs.
        entity_key = entity.entity_lei or f"name:{entity.entity_name}"
        key = (entity_key, host)

        if key not in grouped:
            grouped[key] = (entity, [])
        grouped[key][1].append(DomainEvidence.from_mapping(obs))

    candidates = [
        build_candidate(entity, domain, evs)
        for (_, domain), (entity, evs) in grouped.items()
    ]

    candidates.sort(
        key=lambda c: (
            c.disposition.value,
            c.entity_name.casefold(),
            c.registrable_domain,
            c.candidate_domain,
        )
    )
    return candidates


def write_json(path: Path, candidates: list[DomainCandidate]) -> None:
    payload = {
        "schema": "corporation-helix-domain-candidates/v1",
        "candidates": [c.to_dict() for c in candidates],
        "summary": {
            "total": len(candidates),
            "auto": sum(c.disposition is Disposition.AUTO for c in candidates),
            "review": sum(c.disposition is Disposition.REVIEW for c in candidates),
            "reject": sum(c.disposition is Disposition.REJECT for c in candidates),
        },
    }
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(payload, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")


def print_summary(candidates: list[DomainCandidate]) -> None:
    counts = {d: 0 for d in Disposition}
    for c in candidates:
        counts[c.disposition] += 1

    print("=" * 72)
    print("CORPORATION HELIX - DOMAIN CANDIDATES")
    print("=" * 72)
    print(
        f"Total: {len(candidates)} | "
        f"AUTO: {counts[Disposition.AUTO]} | "
        f"REVIEW: {counts[Disposition.REVIEW]} | "
        f"REJECT: {counts[Disposition.REJECT]}"
    )

    for c in candidates:
        print("-" * 72)
        print(c.candidate_domain)
        print(f"  Entity        : {c.entity_name}")
        print(f"  LEI           : {c.entity_lei or 'UNKNOWN'}")
        print(f"  Relationships : {', '.join(c.relationships) or 'NONE'}")
        print(f"  Corporate conf: {c.corporate_confidence}")
        print(f"  Infra conf    : {c.infrastructure_attribution_confidence.value}")
        print(f"  Disposition   : {c.disposition.value}")
        print(f"  Evidence      : {len(c.evidence)}")
        if c.review_reason:
            print(f"  Reason        : {c.review_reason}")


def parse_args() -> argparse.Namespace:
    p = argparse.ArgumentParser(
        description="Build evidence-bearing domain candidates from corporate entities."
    )
    p.add_argument("--entities", required=True, type=Path, help="Helix entity JSON input")
    p.add_argument(
        "--observations",
        required=True,
        type=Path,
        help="Provider/domain observation JSON input",
    )
    p.add_argument("--out", required=True, type=Path, help="Auditable candidate JSON output")
    return p.parse_args()


def main() -> int:
    args = parse_args()
    entities = load_entities(args.entities)
    observations = load_observations(args.observations)
    candidates = candidates_from_observations(entities, observations)
    write_json(args.out, candidates)
    print_summary(candidates)
    print(f"\nWrote: {args.out}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
